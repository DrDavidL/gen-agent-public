# Azure OpenAI Configuration (Required)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Google Search API (Required)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# Application Password (Optional)
# Default: test_password
PASSWORD=your-secure-password

# OpenAI API (Optional - fallback for vision/embeddings)
OPENAI_API_KEY=your-openai-api-key

# Azure Vision Model (Optional - for PDF image analysis)
AZURE_VISION_DEPLOYMENT=gpt-4o

# Tavily Search API (Optional - alternative web search)
TAVILY_API_KEY=your-tavily-api-key
